{
  "name": "03 - Feedback Sentiment Loop",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "feedback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1d2e3f4-webhook",
      "name": "Feedback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "feedback-hook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/webhooks/feedback",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rating: $json.rating, comment: $json.comment, ticket_id: $json.ticket_id }) }}",
        "options": {"timeout": 8000}
      },
      "id": "c1d2e3f4-score",
      "name": "Score Feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id": "cond-neg", "leftValue": "={{ $json.escalated }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1d2e3f4-if",
      "name": "Was Escalated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const f = $('Feedback Webhook').first().json;\nconst s = $('Score Feedback').first().json;\nreturn [{ json: { text: `🚨 Negative feedback (rating ${f.rating}/5, sentiment ${s.sentiment}): ${f.comment || '(no comment)'}` } }];"
      },
      "id": "c1d2e3f4-format",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Score Feedback').first().json) }}",
        "options": {}
      },
      "id": "c1d2e3f4-respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Feedback Webhook": {"main": [[{"node": "Score Feedback", "type": "main", "index": 0}]]},
    "Score Feedback": {"main": [[{"node": "Was Escalated?", "type": "main", "index": 0}]]},
    "Was Escalated?": {
      "main": [
        [{"node": "Format Alert", "type": "main", "index": 0}],
        [{"node": "Respond", "type": "main", "index": 0}]
      ]
    },
    "Format Alert": {"main": [[{"node": "Respond", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "pinData": {}
}
