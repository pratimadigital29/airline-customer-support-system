# Copy to .env and adjust. Works out-of-the-box with MOCK llm (no API key needed).
ENV=dev
DATABASE_URL=sqlite:///./support.db

# LLM provider: mock | openai | ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# n8n webhook that receives new-ticket events (optional for local dev)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/new-ticket

# SLA thresholds (minutes) per priority
SLA_MINUTES_URGENT=30
SLA_MINUTES_HIGH=120
SLA_MINUTES_NORMAL=480

CORS_ORIGINS=*
